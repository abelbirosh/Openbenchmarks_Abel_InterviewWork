#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
git diff --cached --check

if [ -x .venv/bin/ruff ]; then
    RUFF=.venv/bin/ruff
elif command -v ruff >/dev/null 2>&1; then
    RUFF=$(command -v ruff)
else
    echo 'Ruff is required for commits. Install the dev dependencies: pip install -e ".[dev,web]"' >&2
    exit 1
fi

"$RUFF" check .
"$RUFF" format --check .
