# Copy to .env and fill in. .env is gitignored; never commit a real key.

# API key for the classifier.
OPENAI_API_KEY=

# Optional. Override the endpoint and model the classifier uses.
# CLOSED_BENCH_BASE_URL=
# CLOSED_BENCH_MODEL=

# Optional. A stronger model for the ground-truth web search alone.
# Unset, it uses CLOSED_BENCH_MODEL.
# CLOSED_BENCH_SEARCH_MODEL=

# Optional. The model a run puts under test, and the model that rules on the
# rubrics. Keep them different: a model grading its own work has a documented
# self-preference bias, and `closed-bench run` warns when they match.
# CLOSED_BENCH_SUBJECT_MODEL=
# CLOSED_BENCH_JUDGE_MODEL=

# Optional. Where `closed-bench run` writes results and the dashboard reads them.
# CLOSED_BENCH_RUNS_DIR=runs

# Optional. Keys for the vendors in a board's cohort file. Each cohort row names
# the variable it needs as ${LIKE_THIS}; a row whose key is missing is reported
# as not run rather than scored as bad.
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# TINYFISH_API_KEY=
